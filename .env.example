# Sao chep thanh .env. Dien gia tri rieng, khong dua .env len Git.
SECRET_KEY=
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=ParkingAI
DB_DRIVER=ODBC Driver 18 for SQL Server
# Windows Authentication: true. SQL login: false va dien DB_USER/DB_PASSWORD.
DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=yes
# Chi dung chung chi tu ky tren may local.
DB_TRUST_SERVER_CERTIFICATE=yes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Quan ly bai xe
GEMINI_API_KEY=
# Chon model co quyen truy cap trong tai khoan cua ban (legacy).
GEMINI_MODEL=
# Chatbot AI Local qua Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3:4b
AI_CONFIDENCE_THRESHOLD=0.80
PARKING_MODEL_PATH=ai_models/parking_classifier.keras
PARKING_ROI_PATH=config/parking_slots.json
TESSERACT_CMD=
# Duong dan tren MAY SQL SERVER; tai khoan dich vu SQL Server can quyen ghi.
BACKUP_DIR=C:\ParkingAI_Backups
PORT=5000
# Duong dan Python moi truong co ultralytics/PyTorch cho video YOLO (vi du: D:\miniconda\envs\AIbaidoxe\python.exe)
YOLO_TRAIN_PYTHON=
